{
  "expo": {
    "name": "Botermi",
    "slug": "Botermi",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#b60017"
    },
    "androidStatusBar": {
      "backgroundColor": "#b60017"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-dark.png",
          "imageWidth": 190,
          "backgroundColor": "#b60017",
          "resizeMode": "cover",
          "dark": {
            "image": "./assets/splash-icon-light.png",
            "backgroundColor": "#b60017"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Botermi to use your location."
        }
      ],
      "expo-font"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.botermi.app",
      "buildNumber": "24",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes.",
        "NSLocationWhenInUseUsageDescription": "Allow Botermi to use your location.",
        "NSPhotoLibraryUsageDescription": "Allow Botermi to access your photos",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBvKijMMp2rgpADsvB2cpNL6JOBozQ27TE"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B3071A"
      },
      "package": "com.botermi.app",
      "versionCode": 14,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBvKijMMp2rgpADsvB2cpNL6JOBozQ27TE"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "48d4fc13-aaed-45ed-8833-f2e8f7522a6c"
      }
    }
  }
}
